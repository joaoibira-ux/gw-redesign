rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /medicoes/{arquivo} {
      allow read, write: if true;
    }
    match /boletos/{arquivo} {
      allow read, write: if true;
    }
    match /comprovantes/{arquivo} {
      allow read, write: if true;
    }
    match /diarioObra/{arquivo} {
      allow read, write: if true;
    }
    match /funcionariosDocs/{funcId}/{arquivo} {
      allow read, write: if true;
    }
  }
}
